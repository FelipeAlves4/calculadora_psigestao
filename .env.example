# Banco usado somente pelo comando npm run dev
LOCAL_DATABASE_URL=./data/psigestao.db

# Na Vercel, crie DATABASE_URL com a URI "Transaction pooler" exibida em Connect
# no projeto Supabase xrfkrscihjkstmjtcyud. Não use a URL da API ou chaves do Supabase.
DATABASE_URL=

# Gere um segredo longo e aleatório antes de publicar
AUTH_SECRET=
APP_URL=https://calculadora-psigestao.vercel.app

# Envio de recuperação de senha pelo Resend (opcional)
EMAIL_FROM=
EMAIL_API_KEY=

# Administrador inicial, criado somente quando ainda não existe nenhum admin
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
